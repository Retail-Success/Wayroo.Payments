<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <!-- Transitive advisories flow in via the referenced recorder lambda (Orders SDK -> Refit,
             IdentityModel) — out of our control until the SDK updates them. -->
        <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Amazon.CDK.Lib" Version="2.268.0" />
        <!-- Floor tracks whatever Amazon.CDK.Lib asks for: NuGet resolves a range to its lowest
             version, so a floor under the CDK's own requirement is a package downgrade (NU1605, an
             error here). 2.268.0 wants >= 10.5.0. Raise this alongside the CDK, not on its own. -->
        <PackageReference Include="Constructs" Version="[10.5.0,11.0.0)" />
    </ItemGroup>
    <ItemGroup>
        <!--
          Wayroo.Payments.API is deliberately NOT referenced here, even though both projects are net10
          as of WR-19817. It is a Microsoft.NET.Sdk.Web project, so referencing it would pull ASP.NET
          Core, Swashbuckle and OpenTelemetry into the CDK synth assembly for the sake of one class of
          string constants. The PaymentsAPI construct hardcodes the small set of env-var keys instead
          of importing Wayroo.Payments.API.EnvironmentVariableKeys; if those keys ever change, the
          constants in PaymentsAPI.cs need to be updated alongside. If that hand-sync ever bites,
          promote the keys into Wayroo.Payments.Models (which both projects already reference) rather
          than referencing the web project.
        -->
        <ProjectReference Include="..\..\Wayroo.Payments.ConfigurationRecorder.Lambda\Wayroo.Payments.ConfigurationRecorder.Lambda\Wayroo.Payments.ConfigurationRecorder.Lambda.csproj" />
        <ProjectReference Include="..\..\Wayroo.Payments.DataAccess\Wayroo.Payments.DataAccess\Wayroo.Payments.DataAccess.csproj" />
        <!-- For PaymentsLogSignals, which the CloudWatch metric filters in PaymentsAPI match on.
             Reachable transitively already; direct because this project names the type itself. -->
        <ProjectReference Include="..\..\Wayroo.Payments.Models\Wayroo.Payments.Models\Wayroo.Payments.Models.csproj" />
    </ItemGroup>
</Project>
